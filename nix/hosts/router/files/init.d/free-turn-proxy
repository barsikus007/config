#!/bin/sh /etc/rc.common

START=95
STOP=10

USE_PROCD=1
PROG=/usr/bin/free-turn-proxy-server

start_service() {
    [ -x "$PROG" ] || return 1

    local obf_key=""
    [ -s /etc/free-turn-proxy/obf-key ] && obf_key="$(cat /etc/free-turn-proxy/obf-key)"

    procd_open_instance free-turn-proxy
    procd_set_param command "$PROG" \
        -mode udp \
        -listen "0.0.0.0:56000" \
        -connect "127.0.0.1:51820" \
        -obf-profile rtpopus3 \
        ${obf_key:+-obf-key "$obf_key"}
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
