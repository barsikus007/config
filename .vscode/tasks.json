{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "lint injections (file)",
            "type": "shell",
            "command": "./nix/hooks/lint-injections.lua",
            "args": [
                "${file}"
            ],
            "problemMatcher": {
                "owner": "shellcheck-injections",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error|info):\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            }
        },
        {
            "label": "lint injections (all)",
            "type": "shell",
            "command": "./nix/hooks/lint-injections.lua",
            "args": [],
            "problemMatcher": {
                "owner": "shellcheck-injections",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error|info):\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}