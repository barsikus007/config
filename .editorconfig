root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
# max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

[*.{patch,diff}]
trim_trailing_whitespace = false

[*.md]
#? disabled cause lang block's indents counts as invalid
# indent_size = 2

[*.nix]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 2

[*.py]
indent_size = 4

[*.toml]
indent_size = 2

[*.{json,code-workspace}]
indent_size = 4

[**/{.config/Code/User,.vscode}/{keybindings.json,settings.json}]
insert_final_newline = false

[*.{cjs,js,jsx,ts,tsx}]
indent_size = 2
max_line_length = 120
quote_type = single

[*.user.js]
max_line_length = 200
